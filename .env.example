# Copy this file to .env and fill in your keys

# Required: used for resume parsing and job match scoring
ANTHROPIC_API_KEY=

# Optional but recommended: free key from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSearch aggregates Google for Jobs (includes LinkedIn/Indeed/AllJobs postings)
RAPIDAPI_KEY=

# Model used for scoring (cheap+fast) and parsing
SCORING_MODEL=claude-haiku-4-5-20251001
PARSING_MODEL=claude-sonnet-5

# Optional: email delivery for the daily digest (leave blank to just write HTML files).
# For Gmail use an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_TO=
DIGEST_FROM=

# Private usage dashboard at /stats/<STATS_KEY>. Leave blank and the route does
# not exist at all. Use a long random value: anyone with it sees your numbers.
STATS_KEY=

# Shown in the footer and in the "advertise here" ad slot.
CONTACT_EMAIL=avia.konfino@gmail.com

# How many sponsored slots sit above the match list.
AD_SLOTS=2
